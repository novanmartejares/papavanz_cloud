# HTTP port the API listens on (proxy this through Cloudflare Tunnel)
PORT=8080

# Bind address. Use 0.0.0.0 for LAN + tunnel, 127.0.0.1 for tunnel-only.
HOST=0.0.0.0

# JWT signing secret. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-64-character-random-string-from-openssl

# Where user files live on disk. Point this at an external HDD mount in prod,
# e.g. /mnt/backup-primary/cloud-storage
STORAGE_ROOT=./storage

# SQLite location (Prisma URL).
DATABASE_URL=file:./data/app.db

# Per-user storage cap. 5 GB by default.
DEFAULT_QUOTA_BYTES=5368709120

# Comma-separated list of origins allowed to call the API from a browser.
# In dev, the Vite frontend runs on 5173.
CORS_ORIGINS=http://localhost:5173

# Set to "production" to enable Secure cookies (HTTPS-only).
NODE_ENV=development

# Optional registration gate. When set, POST /auth/register requires the same
# value in the request body's `inviteCode` field; mismatches return 403.
# Leave empty for open registration (default).
INVITE_CODE=

# Optional: absolute path to a built frontend (e.g. C:/papavanz_cloud/web/dist or
# /opt/papavanz_cloud/web/dist). When set and the directory exists, the API
# serves the built frontend from the same origin with an SPA fallback. This
# lets the whole app run through a single port behind Cloudflare Tunnel /
# Tailscale Funnel. Leave empty in dev — Vite dev server handles the frontend.
STATIC_DIR=
